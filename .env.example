# Optional. Join links use the current page origin when this is unset.
# Set it only to an origin where this Acta app is actually served.
# ACTA_PUBLIC_ORIGIN=http://127.0.0.1:4730

# Optional OpenAI-compatible score step. There is no word-list stand-in.
# ACTA_SCORE_BASE_URL=http://127.0.0.1:8091/v1
# ACTA_SCORE_API_KEY=
# ACTA_SCORE_MODEL=local

# Optional local llama.cpp paths used when ACTA_SCORE_BASE_URL is unset.
# Defaults: data/score/llama-server and data/score/model.gguf
# ACTA_LLAMA_SERVER=
# ACTA_SCORE_GGUF=

# ACTA_DB=./data/acta.sqlite
# ACTA_PORT=4730
# ACTA_HOST=127.0.0.1
